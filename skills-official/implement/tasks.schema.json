{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Code Tasks Schema",
  "description": "Document-driven task management with automatic context injection",
  "type": "object",
  "required": ["project", "tasks"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "last_updated"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Project name"
        },
        "description": {
          "type": "string",
          "description": "Project description (optional)"
        },
        "total_tasks": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of tasks"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp (ISO 8601)"
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "List of tasks",
      "items": {
        "type": "object",
        "required": ["id", "goal", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^task-[0-9]+$",
            "description": "Task ID (e.g., task-1)"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "description": "Task goal or objective"
          },
          "description": {
            "type": "string",
            "description": "Detailed task description (optional)"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "blocked"],
            "description": "Current task status"
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Task priority (optional, defaults to medium)"
          },
          "type": {
            "type": "string",
            "enum": ["implementation", "documentation", "test", "refactor", "bugfix", "infrastructure"],
            "description": "Task type (optional, defaults to implementation)"
          },
          "effort": {
            "type": "string",
            "pattern": "^[0-9]+(h|d)$",
            "description": "Effort estimate (e.g., '4h', '2d')"
          },
          "docs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^#]+#[^#]+$",
              "description": "Document reference with section (e.g., 'docs/design.md#Authentication')"
            },
            "description": "Documentation references to inject as context"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Acceptance criteria for this task"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^task-[0-9]+$"
            },
            "description": "Task IDs this task depends on"
          },
          "started_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Task start timestamp (ISO 8601)"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Task completion timestamp (ISO 8601)"
          },
          "assigned_to": {
            "type": "string",
            "description": "Assigned agent or developer (optional)"
          },
          "blocked_reason": {
            "type": ["string", "null"],
            "description": "Reason for blocking (if status is blocked)"
          },
          "git_branch": {
            "type": ["string", "null"],
            "description": "Git branch for this task (optional)"
          },
          "git_commit": {
            "type": ["string", "null"],
            "description": "Git commit hash when completed (optional)"
          }
        }
      }
    }
  }
}
